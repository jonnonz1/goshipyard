{
  "name": "shipyard-cli",
  "version": "0.2.0",
  "description": "Command-line tool + agent skills for Shipyard (goshipyard.app) — post and manage projects, reviews, likes and wallet from the terminal.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonnonz1/goshipyard.git"
  },
  "homepage": "https://goshipyard.app",
  "bin": {
    "shipyard": "cli/index.ts"
  },
  "files": [
    "cli",
    "install.sh"
  ],
  "scripts": {
    "cli": "bun run cli/index.ts",
    "cli:build": "bun build --compile --minify --outfile dist/shipyard cli/index.ts",
    "cli:release": "bun run scripts/build-cli.ts",
    "skills:sync": "bun run scripts/sync-skills.ts",
    "lint": "oxlint cli",
    "format": "prettier --write \"cli/**/*.{ts,md,mdc}\"",
    "format:check": "prettier --check \"cli/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "tsc --noEmit && oxlint cli && prettier --check \"cli/**/*.ts\" && bun test"
  },
  "devDependencies": {
    "bun-types": "^1.3.14",
    "oxlint": "^1.70.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3"
  }
}
